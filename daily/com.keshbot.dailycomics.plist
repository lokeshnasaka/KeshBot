<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.keshbot.dailycomics</string>

    <key>ProgramArguments</key>
    <!-- caffeinate keeps the Mac awake while the job runs, even during a brief background wake -->
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-is</string>
        <string>/Users/lokeshnasaka/Documents/git/KeshBot/.venv/bin/python</string>
        <string>/Users/lokeshnasaka/Documents/git/KeshBot/daily/keshbot_daily.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lokeshnasaka/Documents/git/KeshBot</string>

    <!-- Run every day at 07:00 local time, with backup runs at 07:30 and 08:00 in case
         the first one fails. Already-posted strips are skipped (.last_posted.json). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- If the Mac was asleep at 07:00 and not woken, launchd runs the job at
         the next wake. Pair this with the `pmset` self-wake in README.md so the
         Mac wakes itself at 06:55 and posts on time. -->

    <key>StandardOutPath</key>
    <string>/Users/lokeshnasaka/Documents/git/KeshBot/daily/keshbot_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lokeshnasaka/Documents/git/KeshBot/daily/keshbot_daily.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
